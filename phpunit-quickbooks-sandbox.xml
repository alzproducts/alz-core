<?xml version="1.0" encoding="UTF-8"?>
<!-- Opt-in QuickBooks sandbox run (make test-quickbooks-sandbox): real sandbox calls with the developer's .env QuickBooks keys -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnDeprecation="false"
         failOnPhpunitDeprecation="false"
         failOnNotice="true"
         failOnWarning="true"
>
    <testsuites>
        <testsuite name="QuickBooksSandbox">
            <directory>tests/Integration/QuickBooks</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="QUICKBOOKS_SANDBOX_RUN" value="1" force="true"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- intentional: the token lock and access-token cache must be the ones artisan quickbooks:connect uses -->
        <env name="CACHE_STORE" value="redis"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="SENTRY_LARAVEL_DSN" value="" force="true"/>
        <env name="HELPSCOUT_SYSTEM_USER_ID" value="999999"/>
        <env name="SUPABASE_URL" value="https://test.supabase.co"/>
        <env name="SHOPWIRED_SALE_CATEGORY_ID" value="2000000001"/>
        <!-- Blank secrets switch HelpScout, Slack, Google Ads and Bing to stand-ins (ADR-0015) -->
        <env name="HELPSCOUT_APP_SECRET" value="" force="true"/>
        <env name="SLACK_BOT_USER_OAUTH_TOKEN" value="" force="true"/>
        <env name="GOOGLE_ADS_DEVELOPER_TOKEN" value="" force="true"/>
        <env name="GOOGLE_ADS_CLIENT_SECRET" value="" force="true"/>
        <env name="GOOGLE_ADS_REFRESH_TOKEN" value="" force="true"/>
        <env name="BING_ADS_CLIENT_SECRET" value="" force="true"/>
        <env name="BING_ADS_REFRESH_TOKEN" value="" force="true"/>
        <env name="BING_ADS_DEVELOPER_TOKEN" value="" force="true"/>
        <!-- intentional: no QUICKBOOKS_* or API_KEY_ENCRYPTION_SECRET entries; even an unforced one would win over .env -->
    </php>
    <extensions>
        <bootstrap class="DG\BypassFinals\PHPUnitExtension"/>
    </extensions>
</phpunit>

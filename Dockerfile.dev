# ==============================================================================
# Offline self-contained dev image (tests + linters, no network at runtime)
# ==============================================================================
# Build: docker build -f Dockerfile.dev $(sed 's/^/--build-arg /' database/baseline/versions.env) -t alz-core-dev .
# Run:   docker run --rm --network none alz-core-dev make test TEST_ARGS=--exclude-group=repo-static
# Bakes vendor (with dev deps), .env and the Supabase baseline (ADR-0016), migrated on database `postgres` as role `postgres`.
# Each start re-runs Realtime's tenant set-up (about 4 s), so realtime.messages has a partition for that day.
# Not included: Redis, Swoole/Octane, integration tests.
# Uses Dockerfile.dev.dockerignore (BuildKit), not the production .dockerignore.
# ==============================================================================

ARG SUPABASE_POSTGRES_VERSION
ARG SUPABASE_AUTH_VERSION
ARG SUPABASE_REALTIME_VERSION

FROM supabase/auth:${SUPABASE_AUTH_VERSION} AS auth

FROM supabase/realtime:${SUPABASE_REALTIME_VERSION} AS realtime

FROM supabase/postgres:${SUPABASE_POSTGRES_VERSION}

# intentional: stays root — throwaway sandbox, avoids storage/lint-cache permission friction
USER root

# CI's extension list (.github/workflows/ci.yml) plus what the php:*-cli images build in.
RUN apk update && apk add --no-cache \
      make git \
      php84 php84-phar php84-openssl php84-tokenizer php84-ctype php84-fileinfo php84-session php84-sodium \
      php84-posix php84-opcache php84-dom php84-xml php84-xmlreader php84-xmlwriter php84-simplexml \
      php84-curl php84-mbstring php84-zip php84-pcntl php84-pdo php84-pdo_pgsql php84-pgsql php84-bcmath \
      php84-soap php84-intl php84-gd php84-exif php84-iconv php84-pecl-redis \
    && ln -sf /usr/bin/php84 /usr/bin/php

RUN { \
      echo "memory_limit=512M"; \
      echo "zend.assertions=1"; \
      echo "opcache.enable_cli=1"; \
    } > /etc/php84/conf.d/zzzz-dev.ini

COPY --from=composer:2.8 /usr/bin/composer /usr/bin/composer
COPY --from=auth /usr/local/bin/auth /usr/local/bin/auth
COPY --from=auth /usr/local/etc/auth/migrations /usr/local/etc/auth/migrations
COPY database/baseline/roles.sql /docker-entrypoint-initdb.d/init-scripts/99-roles.sql
# intentional: Realtime's whole root filesystem, run by chroot; its Elixir release cannot be copied in as Auth's binary is (COR-381 P2).
COPY --from=realtime / /opt/realtime
COPY database/baseline/realtime-migrate.sh /opt/realtime/usr/local/bin/realtime-migrate

# intentional: a fixed password is safe only because the server never listens beyond loopback.
ENV POSTGRES_PASSWORD=password
# intentional: not the default /var/lib/postgresql/data, the usual data-volume mount point, so a mounted volume cannot hide the cluster baked at build time.
ENV PGDATA=/var/lib/postgresql/baked

WORKDIR /var/www/html

COPY composer.json composer.lock ./

RUN composer install \
    --no-interaction \
    --prefer-dist \
    --no-progress \
    --no-scripts \
    --no-autoloader \
    --ignore-platform-req=ext-swoole

COPY . .

# .env precedes package discovery: without it APP_ENV defaults to production and
# AppServiceProvider's production config guard aborts the boot.
RUN cp .env.example .env \
    && set_env() { \
         if grep -q "^$1=" .env; then sed -i "s|^$1=.*|$1=$2|" .env; else echo "$1=$2" >> .env; fi; \
       } \
    && set_env DB_HOST 127.0.0.1 \
    && set_env DB_PORT 5432 \
    && set_env DB_DATABASE postgres \
    && set_env DB_USERNAME postgres \
    && set_env DB_PASSWORD password \
    && set_env DB_SSLMODE disable \
    && set_env CACHE_STORE array \
    && set_env SESSION_DRIVER array \
    && set_env QUEUE_CONNECTION sync \
    && set_env TELESCOPE_ENABLED false

RUN mkdir -p \
      storage/framework/cache/data \
      storage/framework/sessions \
      storage/framework/views \
      storage/framework/testing \
      storage/logs \
      bootstrap/cache \
    && composer dump-autoload --optimize \
    && composer run-script post-autoload-dump \
    && php artisan key:generate

# intentional: a build seam only; a port the build's Postgres does not listen on makes Realtime's tenant set-up fail.
ARG REALTIME_TENANT_DB_PORT=5432

# Single RUN so the layer holds a cleanly stopped cluster: init, Auth and Realtime migrations, then Laravel's as non-superuser postgres.
# intentional: artisan, not `make migrate` — /.dockerenv is absent during docker build.
RUN set -eu \
    && (docker-entrypoint.sh postgres -D /etc/postgresql -c "data_directory=$PGDATA" -c listen_addresses=127.0.0.1 &) \
    && until pg_isready -q -h 127.0.0.1 -U postgres; do sleep 1; done \
    && GOTRUE_DB_DRIVER=postgres \
       GOTRUE_DB_DATABASE_URL="postgres://supabase_auth_admin:$POSTGRES_PASSWORD@127.0.0.1:5432/postgres" \
       GOTRUE_DB_MIGRATIONS_PATH=/usr/local/etc/auth/migrations \
       GOTRUE_JWT_SECRET=baseline-migrate-placeholder-secret-not-used \
       API_EXTERNAL_URL=http://localhost:9999 \
       GOTRUE_SITE_URL=http://localhost:3000 \
       auth migrate \
    && env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/tmp \
         DB_HOST=127.0.0.1 DB_PASSWORD="$POSTGRES_PASSWORD" SELF_HOST_TENANT_DB_PORT="$REALTIME_TENANT_DB_PORT" \
         chroot /opt/realtime bash /usr/local/bin/realtime-migrate \
    && php artisan migrate --force \
    && su-exec postgres pg_ctl -D "$PGDATA" -m fast -w stop

COPY --chmod=755 <<'EOF' /usr/local/bin/dev-entrypoint
#!/bin/sh
set -eu
su-exec postgres pg_ctl -D /etc/postgresql -o "-c data_directory=$PGDATA -c listen_addresses=127.0.0.1" -w start >/dev/null
until pg_isready -q -h 127.0.0.1 -U postgres; do sleep 0.2; done
# intentional: re-run at every start so a realtime.messages partition covers the start date on an image of any age (COR-381 P3, P4).
env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/tmp \
  DB_HOST=127.0.0.1 DB_PASSWORD="$POSTGRES_PASSWORD" \
  chroot /opt/realtime bash /usr/local/bin/realtime-migrate >/tmp/realtime-migrate.log 2>&1 \
  || { cat /tmp/realtime-migrate.log >&2; exit 1; }
exec "$@"
EOF

ENTRYPOINT ["/usr/local/bin/dev-entrypoint"]
CMD ["bash"]

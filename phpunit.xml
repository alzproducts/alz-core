<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnDeprecation="false"
         failOnPhpunitDeprecation="false"
         failOnNotice="true"
         failOnWarning="true"
>
    <testsuites>
        <!-- Layer-based test suites (Clean Architecture) -->
        <testsuite name="Domain">
            <directory>tests/Unit/Domain</directory>
        </testsuite>
        <testsuite name="Application">
            <directory>tests/Unit/Application</directory>
            <directory>tests/Feature/Application</directory>
        </testsuite>
        <testsuite name="Infrastructure">
            <directory>tests/Unit/Infrastructure</directory>
            <directory>tests/Feature/Infrastructure</directory>
        </testsuite>
        <testsuite name="Presentation">
            <directory>tests/Feature/Presentation</directory>
            <directory>tests/Unit/Presentation</directory>
        </testsuite>
        <!-- Integration tests — require live DB (Supabase); fail = sync local + prod -->
        <!-- CI skips this suite via the `exclude-group=integration` Pest flag; locally run it with make test-integration -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!-- Supporting test suites -->
        <!-- Temporarily disabled: Google Ads SDK PHP 8.4 deprecation - see todo.php
        <testsuite name="Architecture">
            <file>tests/ArchitectureTest.php</file>
        </testsuite>
        -->
        <testsuite name="Providers">
            <directory>tests/Unit/Providers</directory>
            <directory>tests/Feature/Providers</directory>
        </testsuite>
        <testsuite name="DevTools">
            <directory>tests/Unit/DevTools</directory>
        </testsuite>
        <testsuite name="Database">
            <directory>tests/Unit/Database</directory>
            <directory>tests/Unit/Static</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <report>
            <clover outputFile="build/logs/clover.xml"/>
        </report>
    </coverage>
    <source ignoreIndirectDeprecations="true">
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/DevTools/GitHooks</directory>
            <file>app/Models/User.php</file>
            <directory suffix="ServiceProvider.php">./app</directory>
            <directory suffix="Exception.php">./app</directory>
            <directory suffix="Factory.php">./app</directory>
            <file>app/Domain/Review/Rating.php</file>
            <!-- Domain Events are data carriers with no logic (TestingStrategy.md) -->
            <directory suffix="Event.php">./app/Domain</directory>
            <!-- SOAP transport - tested via smoke tests, mocking is brittle -->
            <file>app/Infrastructure/BingAds/BingAdsTransport.php</file>
            <!-- Orchestration UseCases - pure delegation, no testable business logic (TestingStrategy.md) -->
            <file>app/Application/Shopwired/UseCases/SyncProductsUseCase.php</file>
            <file>app/Application/Shopwired/UseCases/SyncCustomFieldsUseCase.php</file>
            <file>app/Application/Shopwired/UseCases/ReconcileProductsUseCase.php</file>
            <!-- Simple result value objects - minimal logic, type system handles structure -->
            <file>app/Application/ValueObjects/ReconcileResult.php</file>
            <!-- Pure delegation UseCases - no branching logic (TestingStrategy.md) -->
            <file>app/Application/ContactSubmission/UseCases/SubmitContactFormUseCase.php</file>
            <!-- Simple result value objects - minimal logic -->
            <file>app/Application/ContactSubmission/Results/SubmitContactFormResult.php</file>
        </exclude>
    </source>
    <!-- Opt-in: the list-parity and docker groups run only when selected with Pest's group flag. A command-line exclude-group flag replaces this default, so a target passing its own must name both too. -->
    <groups>
        <exclude>
            <group>list-parity</group>
            <group>docker</group>
        </exclude>
    </groups>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="SENTRY_LARAVEL_DSN" value="" force="true"/>
        <env name="HELPSCOUT_SYSTEM_USER_ID" value="999999"/>
        <env name="SUPABASE_URL" value="https://test.supabase.co"/>
        <env name="SHOPWIRED_SALE_CATEGORY_ID" value="2000000001"/>
        <!-- Blank secrets switch HelpScout, Slack, Google Ads and Bing to stand-ins (ADR-0015) -->
        <env name="HELPSCOUT_APP_SECRET" value="" force="true"/>
        <env name="SLACK_BOT_USER_OAUTH_TOKEN" value="" force="true"/>
        <env name="GOOGLE_ADS_DEVELOPER_TOKEN" value="" force="true"/>
        <env name="GOOGLE_ADS_CLIENT_SECRET" value="" force="true"/>
        <env name="GOOGLE_ADS_REFRESH_TOKEN" value="" force="true"/>
        <env name="BING_ADS_CLIENT_SECRET" value="" force="true"/>
        <env name="BING_ADS_REFRESH_TOKEN" value="" force="true"/>
        <env name="BING_ADS_DEVELOPER_TOKEN" value="" force="true"/>
        <!-- QBO placeholders: tests must never inherit a developer's sandbox keys -->
        <env name="QUICKBOOKS_ENVIRONMENT" value="sandbox" force="true"/>
        <env name="QUICKBOOKS_CLIENT_ID" value="test-client-id" force="true"/>
        <env name="QUICKBOOKS_CLIENT_SECRET" value="test-client-secret" force="true"/>
        <env name="QUICKBOOKS_REDIRECT_URI" value="http://localhost/quickbooks/callback" force="true"/>
        <env name="QUICKBOOKS_REALM_ID" value="9130000000000001" force="true"/>
        <env name="QUICKBOOKS_CACHE_STORE" value="array" force="true"/>
        <env name="API_KEY_ENCRYPTION_SECRET" value="000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f" force="true"/>
        <!-- Parallel workers share the migrated baseline database: per-worker copies come from template1, with no auth schema (ADR-0016) -->
        <server name="LARAVEL_PARALLEL_TESTING_WITHOUT_DATABASES" value="1"/>
    </php>
    <extensions>
        <bootstrap class="DG\BypassFinals\PHPUnitExtension"/>
    </extensions>
</phpunit>
